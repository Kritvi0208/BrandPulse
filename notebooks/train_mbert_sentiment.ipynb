{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# BrandPulse — Fine-Tune mBERT Sentiment Model Checkpoint\n",
    "\n",
    "This notebook fine-tunes the `ganeshkharad/gk-hinglish-sentiment` base architecture on the preprocessed multilingual tech news and review datasets (`multi_ling_tech_(single)reviews.csv` + `mling_tech_revs_var_brands.csv`).\n",
    "\n",
    "The output checkpoint is saved as `models/mbert-for-sentiment.pth` for direct compatibility with `SentimentClassifier`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "import time\n",
    "import random\n",
    "from pathlib import Path\n",
    "\n",
    "PROJECT_ROOT = Path.cwd().parent if Path.cwd().name == 'notebooks' else Path.cwd()\n",
    "if str(PROJECT_ROOT / 'src') not in sys.path:\n",
    "    sys.path.insert(0, str(PROJECT_ROOT / 'src'))
    "if str(PROJECT_ROOT) not in sys.path:\n",
    "    sys.path.insert(0, str(PROJECT_ROOT))\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "import transformers\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import classification_report, confusion_matrix, accuracy_score, precision_recall_fscore_support\n",
    "\n",
    "from src.sentiment_classification import TokenClassifier\n",
    "from src.sentiment_inference import SentimentClassifier\n",
    "\n",
    "SEED = 42\n",
    "random.seed(SEED)\n",
    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)\n",
    "\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print('Device:', device)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load Preprocessed Dataset\n",
    "data_path = PROJECT_ROOT / 'scratch' / 'processed_sentiment_data.csv'\n",
    "df = pd.read_csv(data_path)\n",
    "print(f'Total preprocessed records: {len(df):,}')\n",
    "\n",
    "train_df, temp_df = train_test_split(df, test_size=0.20, random_state=SEED, stratify=df['sentiment'])\n",
    "val_df, test_df = train_test_split(temp_df, test_size=0.50, random_state=SEED, stratify=temp_df['sentiment'])\n",
    "print(f'Train: {len(train_df):,} | Val: {len(val_df):,} | Test: {len(test_df):,}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Class Weights & Tokenizer Setup\n",
    "counts = train_df['sentiment'].value_counts().sort_index().values\n",
    "weights = len(train_df) / (3 * counts)\n",
    "class_weights_tensor = torch.tensor(weights, dtype=torch.float32).to(device)\n",
    "print('Class weights:', weights)\n",
    "\n",
    "MODEL_NAME = 'ganeshkharad/gk-hinglish-sentiment'\n",
    "tokenizer = transformers.AutoTokenizer.from_pretrained(MODEL_NAME)\n",
    "base_model = transformers.AutoModelForSequenceClassification.from_pretrained(MODEL_NAME, num_labels=3)\n",
    "model = TokenClassifier(base_model, threshold=0.5).to(device)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Dataset and Dataloader\n",
    "class SentimentDataset(Dataset):\n",
    "    def __init__(self, texts, labels, tokenizer, max_len=512):\n",
    "        self.texts = texts\n",
    "        self.labels = labels\n",
    "        self.tokenizer = tokenizer\n",
    "        self.max_len = max_len\n",
    "    def __len__(self):\n",
    "        return len(self.texts)\n",
    "    def __getitem__(self, idx):\n",
    "        text = str(self.texts[idx])\n",
    "        label = int(self.labels[idx])\n",
    "        encoding = self.tokenizer(text, truncation=True, padding='max_length', max_length=self.max_len, return_tensors='pt')\n",
    "        return {'input_ids': encoding['input_ids'].flatten(), 'attention_mask': encoding['attention_mask'].flatten(), 'labels': torch.tensor(label, dtype=torch.long)}\n",
    "\n",
    "train_sub = train_df.sample(n=min(20000, len(train_df)), random_state=SEED)\n",
    "val_sub = val_df.sample(n=min(3000, len(val_df)), random_state=SEED)\n",
    "test_sub = test_df.sample(n=min(3000, len(test_df)), random_state=SEED)\n",
    "\n",
    "train_loader = DataLoader(SentimentDataset(train_sub['text'].values, train_sub['sentiment'].values, tokenizer), batch_size=16, shuffle=True)\n",
    "val_loader = DataLoader(SentimentDataset(val_sub['text'].values, val_sub['sentiment'].values, tokenizer), batch_size=16, shuffle=False)\n",
    "test_loader = DataLoader(SentimentDataset(test_sub['text'].values, test_sub['sentiment'].values, tokenizer), batch_size=16, shuffle=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Training Loop\n",
    "criterion = nn.CrossEntropyLoss(weight=class_weights_tensor)\n",
    "optimizer = torch.optim.AdamW(model.parameters(), lr=2e-5, weight_decay=0.01)\n",
    "\n",
    "EPOCHS = 2\n",
    "for epoch in range(EPOCHS):\n",
    "    model.train()\n",
    "    total_loss = 0\n",
    "    for batch in train_loader:\n",
    "        input_ids = batch['input_ids'].to(device)\n",
    "        attention_mask = batch['attention_mask'].to(device)\n",
    "        labels = batch['labels'].to(device)\n",
    "        optimizer.zero_grad()\n",
    "        logits = model({'input_ids': input_ids, 'attention_mask': attention_mask})\n",
    "        loss = criterion(logits, labels)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        total_loss += loss.item()\n",
    "    print(f'Epoch {epoch+1}/{EPOCHS} Loss: {total_loss/len(train_loader):.4f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save Checkpoint and Test Compatibility\n",
    "ckpt_path = PROJECT_ROOT / 'models' / 'mbert-for-sentiment.pth'\n",
    "torch.save(model.state_dict(), ckpt_path)\n",
    "print('Saved checkpoint to', ckpt_path)\n",
    "\n",
    "classifier = SentimentClassifier(bert_path=str(ckpt_path))\n",
    "print('SentimentClassifier test:', classifier.predict([{'Text_ID': 't1', 'Text': 'Apple launch is amazing'}], is_tweets=True))"
   ]
  }
 ],
